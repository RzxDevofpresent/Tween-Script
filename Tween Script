EaseBtn.MouseButton1Click:Connect(function()
    local order = {"Suave", "Linear", "Rápido", "Elástico"}
    for i, name in ipairs(order) do
        if name == easingAtual then
            easingAtual = order[(i % #order) + 1]
            break
        end
    end
    EaseBtn.Text = "Style: " .. easingAtual
end)

-- TWEEN MELHORADO
TweenBtn.MouseButton1Click:Connect(function()
    if tweening then return end
    local root = getRoot()
    if not root then return end

    if not savedPoint then
        TweenBtn.Text = "❌ SALVA UM PONTO!"
        task.wait(1)
        TweenBtn.Text = "🚀 TWEEN"
        return
    end

    local speed = math.max(tonumber(SpeedBox.Text) or 70, 1)
    local distance = (savedPoint.Position - root.Position).Magnitude
    local tempo = distance / speed

    tweening = true
    TweenBtn.Text = "⏳ VIAJANDO..."
    TweenBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)

    root.Anchored = true
    ativarNoclip() -- atravessa parede e players no caminho 👀

    currentTween = TweenService:Create(
        root,
        TweenInfo.new(tempo, EASINGS[easingAtual]),
        {CFrame = savedPoint}
    )
    currentTween:Play()

    local con
    con = currentTween.Completed:Connect(function()
        con:Disconnect()
        desativarNoclip()
        root.Anchored = false
        tweening = false
        currentTween = nil
        TweenBtn.Text = "🚀 TWEEN"
        TweenBtn.BackgroundColor3 = Color3.fromRGB(85, 170, 255)
    end)
end)
